{
  "manifest_version": 3,
  "name": "YouTube Shorts Limiter",
  "version": "1.0",
  "description": "Limits YouTube Shorts viewing to 15 minutes, then blocks for a configurable cooldown period.",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Shorts Limiter"
  }
}
